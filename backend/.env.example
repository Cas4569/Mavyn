# MAVYN Backend Environment Variables
# Copy to .env and modify as needed

# App
APP_NAME="MAVYN Backend"
APP_VERSION="0.1.0"
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173"]

# Server
HOST="0.0.0.0"
PORT=8000

# NVIDIA NIM (reasoning over Tavily search evidence)
NIM_API_KEY=
NIM_MODEL="mistralai/mistral-large-4-1t-a52b"
NIM_FALLBACK_MODELS="mistralai/mistral-large-4-1t-a52b,moonshotai/kimi-k3.1-pro,nvidia/nemotron-3-ultra-550b-a55b"
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Tavily (live web search and evidence)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH="basic"
TAVILY_MAX_RESULTS=3

# Legacy Gemini compatibility (optional)
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.8-flash"

MARKET_DATA_CACHE_TTL_SECONDS=21600

# Future: Firebase / Database (not used in MVP)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=