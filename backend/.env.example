# MAVYN Backend Environment Variables
# Copy to .env and modify as needed

# App
APP_NAME="MAVYN Backend"
APP_VERSION="0.1.0"
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173"]

# Server
HOST="0.0.0.0"
PORT=8000

# Gemini (required for live market research and AI content generation)
# Create a key in Google AI Studio and keep it in this backend-only file.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash"
MARKET_DATA_CACHE_TTL_SECONDS=21600

# Future: Firebase / Database (not used in MVP)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=