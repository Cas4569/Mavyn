# MAVYN Backend Environment Variables
# Copy to .env and modify as needed

# App
APP_NAME="MAVYN Backend"
APP_VERSION="0.1.0"
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173"]

# Server
HOST="0.0.0.0"
PORT=8000

# Future: LLM API keys (not used in MVP)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Future: Firebase / Database (not used in MVP)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=